# SubBuild Studio Optional Environment Defaults
# Multi-provider AI API keys (Google Gemini, OpenAI, Anthropic, Ollama) and per-stage models are
# normally configured in the in-app Settings UI (saved to storage/provider_keys.json and storage/settings.json).
# Optional legacy Google key fallback:
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BATCH_SIZE=120
# One extra Gemini call per job that builds a character/gender/terminology glossary
GEMINI_GLOSSARY_PASS=true
# On-screen text detection: vision model, seconds between sampled frames, max frames per job
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
ONSCREEN_FRAME_INTERVAL=2.0
ONSCREEN_MAX_FRAMES=360

# Faster-Whisper Local Transcription Defaults
WHISPER_DEFAULT_MODEL=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# Batched GPU inference (much faster). Lower it if you run out of VRAM; 0 disables.
WHISPER_BATCH_SIZE=8

# Subtitle Formatting Rules
MAX_CHARS_PER_LINE=42
MAX_CPS_WARNING=20.0
TARGET_CPS=17.0
MIN_SUBTITLE_DURATION=1.0
MAX_SUBTITLE_DURATION=7.0

# Paths & Server Configuration
STORAGE_DIR=./storage
DATABASE_URL=sqlite:///./storage/subbuild.db
HOST=127.0.0.1
PORT=8000
# If you set HOST=0.0.0.0 for LAN access, add the host names you will use, e.g.
# ALLOWED_HOSTS=["localhost","127.0.0.1","my-pc","192.168.1.20"]

# Updates: a release is installed only if its tag is signed by a key listed in the release-signers
# file at the root of the app (git tag -s vX.Y.Z). This is on by itself whenever that file exists;
# set false only for development builds, or true to require signatures even without the file.
# SUBBUILD_REQUIRE_SIGNED_TAGS=
