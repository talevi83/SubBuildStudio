# Windows batch files need CRLF line endings (cmd mis-parses labels otherwise)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
# Unix / macOS shell scripts need LF line endings
*.sh text eol=lf
*.command text eol=lf
# VERSION is filled in by Git when GitHub builds a release zip (see backend/app/core/updater.py)
VERSION export-subst
# The AppImage entry point and desktop file have no extension
packaging/linux/AppRun text eol=lf
*.desktop text eol=lf
.github/scripts/*.sh text eol=lf
